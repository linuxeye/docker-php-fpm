	&& sed -i'' 's|.*"thread".*|  <policy domain="resource" name="thread" value="1"/>|g' /etc/ImageMagick-7/policy.xml \
	&& sed -i'' 's|.*<policy domain="coder".*"PS".*||g' /etc/ImageMagick-7/policy.xml \
	&& sed -i'' 's|.*<policy domain="coder".*"PS2".*||g' /etc/ImageMagick-7/policy.xml \
	&& sed -i'' 's|.*<policy domain="coder".*"PS3".*||g' /etc/ImageMagick-7/policy.xml \
	&& sed -i'' 's|.*<policy domain="coder".*"EPS".*||g' /etc/ImageMagick-7/policy.xml \
	&& sed -i'' 's|.*<policy domain="coder".*"PDF".*||g' /etc/ImageMagick-7/policy.xml \
	&& sed -i'' 's|.*<policy domain="coder".*"XPS".*||g' /etc/ImageMagick-7/policy.xml \
	&& sed -i'' 's|.*<policy domain="coder".*"PS".*||g' /etc/ImageMagick-7/policy.xml \
	&& sed -i'' 's|.*<policy domain="delegate".*pattern="gs".*||g' /etc/ImageMagick-7/policy.xml \
