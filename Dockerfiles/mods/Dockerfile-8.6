###
### Install and enable PHP modules
###
# Enable ffi if it exists
RUN set -eux \
	&& if [ -f /usr/local/etc/php/conf.d/docker-php-ext-ffi.ini ]; then \
			echo "ffi.enable = 1" >> /usr/local/etc/php/conf.d/docker-php-ext-ffi.ini; \
		fi

# -------------------- Installing PHP Extension: amqp --------------------
RUN set -eux \
	# Installation: Generic
	# Type:         PIE extension
	# Custom:       pie command
	#&& echo "/usr" | pie install php-amqp/php-amqp \
	# Enabling
	#&& docker-php-ext-enable amqp \
	#&& true
        && curl -fsSL -o /tmp/php-amqp.tar.gz https://github.com/php-amqp/php-amqp/archive/refs/tags/v2.2.0.tar.gz \
        && mkdir -p /tmp/php-amqp-src \
        && tar -xzf /tmp/php-amqp.tar.gz -C /tmp/php-amqp-src --strip-components=1 \
        # 1. 全局替换 XtOffsetOf -> offsetof
        && grep -rl 'XtOffsetOf' /tmp/php-amqp-src --include='*.c' --include='*.h' | xargs sed -i 's/\bXtOffsetOf\b/offsetof/g' \
        # 2. 为 INI_STR / INI_INT / INI_FLT 提供后备定义（PHP 8.6 已移除）
        && printf '%s\n' \
            '#ifndef INI_STR' \
            '# define INI_STR(name)  ((char *) zend_ini_string((name), strlen(name), 0))' \
            '#endif' \
            '#ifndef INI_INT' \
            '# define INI_INT(name)  ((zend_long) zend_ini_long((name), strlen(name), 0))' \
            '#endif' \
            '#ifndef INI_FLT' \
            '# define INI_FLT(name)  ((double) zend_ini_double((name), strlen(name), 0))' \
            '#endif' \
            >> /tmp/php-amqp-src/php_amqp.h \
        && cd /tmp/php-amqp-src \
        && phpize \
        && ./configure --with-amqp \
        && make -j$(getconf _NPROCESSORS_ONLN) \
        && make install \
        && docker-php-ext-enable amqp \
        && cd / \
        && rm -rf /tmp/php-amqp-src /tmp/php-amqp.tar.gz \
        && true

